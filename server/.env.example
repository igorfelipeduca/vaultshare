NODE_ENV=development
HOST=127.0.0.1
PORT=3333
DATABASE_PATH=data/vaultshare.db
STORAGE_DIR=storage
# Obrigatória em produção. Gere com: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Lista separada por vírgula; "*" casa um trecho de subdomínio (ex.: https://vaultshare-*-time.vercel.app)
CORS_ORIGINS=http://localhost:5173
PUBLIC_LINK_HOST=vaultshare.app
MAX_UPLOAD_BYTES=104857600
SESSION_TTL_DAYS=7
LOG_LEVEL=info
# Senha da conta de demonstração criada por "npm run seed" (opcional; sem ela uma senha aleatória é gerada)
SEED_PASSWORD=
